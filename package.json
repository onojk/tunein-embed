{
  "name": "tunein-embed",
  "version": "0.1.0",
  "description": "Drop-in, zero-build web player for Icecast and SHOUTcast internet radio streams.",
  "license": "MIT",
  "author": "Jonathan Kendall",
  "repository": "github:onojk/tunein-embed",
  "main": "dist/player.js",
  "files": ["dist", "embed.html"],
  "scripts": {
    "build": "npx --yes esbuild@0.28.2 src/index.js --bundle --minify --format=iife --target=es2018 --legal-comments=inline --outfile=dist/player.js && node scripts/size.js",
    "dev": "npx --yes esbuild@0.28.2 src/index.js --bundle --format=iife --target=es2018 --outfile=dist/player.js --watch",
    "test": "npx --yes esbuild@0.28.2 test/parsers.test.js --bundle --platform=node --log-level=warning | node",
    "mock": "python3 test/mock-server.py"
  }
}
